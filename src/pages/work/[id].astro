---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";

// 1. Generate a path for every entry in the "work" collection
export async function getStaticPaths() {
  const workEntries = await getCollection("work");
  const allTags = [
    ...new Set(workEntries.flatMap((entry) => entry.data.tags || [])),
  ];
  return workEntries.map((entry) => ({
    params: { id: entry.id },
    props: { entry, allTags },
  }));
}

// 2. Get the entry for the current page and render its markdown content
const { entry, allTags } = Astro.props;
const { Content } = await render(entry);
---

<Layout>
  <main>
    <header class="page-header">
      <div class="header-info">
        <div class="header-metadata">
          <p class="date">{entry.data.year}</p>
        </div>
        <h1>{entry.data.title}</h1>
        {
          entry.data.tags && entry.data.tags.length > 0 && (
            <ul class="tags">
              {entry.data.tags.map((tag, index) => (
                <li>
                  #{tag}
                  {index < entry.data.tags.length - 1 && ", "}
                </li>
              ))}
            </ul>
          )
        }
      </div>
      <figure class="p5-flow-grid" id="p5-flow-grid"></figure>
    </header>
  </main>
  <section class="article-content">
    <Content />
  </section>
</Layout>

<style lang="scss">
  .page-header {
    border: 2px solid;
    border-radius: 5px;
    position: relative;
  }
  .p5-flow-grid {
    width: 100%;
    height: 100%;
    inset: 0;
    z-index: 0;
    position: absolute;
  }
  .header-info {
    background: $background-color;
    padding: 1.5rem 3rem;
    margin: 4rem 2rem;
    border-radius: 10px;
    z-index: 3;
    position: relative;
    box-shadow: 10px 10px 0px $primary-color;
    width: min-content;
    min-width: 50%;
    h1 {
      font-size: 6rem;
      text-shadow: 3px 3px 0 $secondary-color;
      line-height: 1;
      width: fit-content !important;
      text-wrap: balance;
    }
  }
  .date,
  .tags {
    font-family: $h-font;
    color: $secondary-color;
    font-size: 1.2rem;
    /* text-shadow: 1px 1px 0 $primary-color; */
    font-weight: bold;
    margin-bottom: 0;
  }
  .date {
    width: fit-content;
  }
  .tags {
    list-style-type: none;
    padding: 0;
    display: flex;
    li {
      padding: 0 0.5rem 0 0;
    }
  }

  .article-content {
    padding: 4rem 0;
    margin: 0 auto;
    max-width: 700px;
    width: 100%;
  }
</style>
<script>
  import p5 from "p5";
  import { initFlowFieldGrid } from "../../sketches/gridFlowField.ts";
  initFlowFieldGrid(p5, "p5-flow-grid");
</script>
